#!/usr/bin/env bash
# view-ticket: Open a Jira ticket in the browser
# Usage: view-ticket <ticket-key>

set -euo pipefail

die() { echo "❌ $*" >&2; exit 1; }

[[ $# -lt 1 ]] && die "Usage: view-ticket <ticket-key>"
[[ ! "$1" =~ ^[A-Z]+-[0-9]+$ ]] && die "'$1' doesn't look like a valid Jira key (e.g. CW-123)."

xdg-open "https://khalibre.atlassian.net/browse/$1" &>/dev/null &
disown
