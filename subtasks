#!/usr/bin/env bash
# subtasks: Lists subtasks of one or more Jira tickets
# Usage: subtasks <TICKET-KEY> [<TICKET-KEY> ...] [-a] [--hide-done]
#   -a           Show all subtasks (default: only unassigned)
#   --hide-done  Hide subtasks with Done/Closed/Resolved/Merged status

set -euo pipefail

# ── Helpers ──────────────────────────────────────────────────────────────────
R='\033[0;31m'      # Red
O='\033[38;5;208m'  # Orange
Y='\033[0;33m'      # Yellow
G='\033[0;32m'      # Green
B='\033[0;34m'      # Blue
W='\033[1;37m'      # Bright White
D='\033[0;90m'      # Dark Gray
C='\033[0;36m'      # Cyan
M='\033[0;35m'      # Magenta
NC='\033[0m'        # Reset / No Color

die()  { echo -e "${R}✖${NC} $*" >&2; exit 1; }
error()  { echo -e "${R}✖${NC} $*"; }
info() { echo -e "${C}▶${NC} $*"; }
ok()   { echo -e "${G}✔${NC} $*"; }
warn() { echo -e "${O}▲${NC} $*"; }

# ── Parse arguments ───────────────────────────────────────────────────────────
FIX_VERSION=""
PROVIDED_FIX_VERSION=""
SHOW_ALL=false
HIDE_DONE=false
IN_PROGRESS=false
MY_TASK=false
NO_ASSIGNEE=false
TICKET_KEYS=()
PROVIDED_TICKET_KEYS=()
JQL_FLAGS=()
CUR_USER_EMAIL=$(acli auth status 2>/dev/null | awk -F': ' '/Email:/ {print $2}')

DIM=$'\033[2m'
RESET=$'\033[0m'

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a)          SHOW_ALL=true;  shift ;;
    --hide-done) HIDE_DONE=true; shift ;;
    --mine)      MY_TASK=true; shift  ;;
    --unassigned)      NO_ASSIGNEE=true; shift  ;;
    --in-progress)     IN_PROGRESS=true; shift  ;;
    --fix-version)
      FIX_VERSION="$2"
      PROVIDED_FIX_VERSION="$2"
      shift 2
      ;;
    -h|--help)
      echo -e "Usage: ${DIM}subtasks <TICKET-KEY> [<TICKET-KEY> ...] [--hide-done]${RESET}"
      echo -e "  ${DIM}-a${RESET}             Show all subtasks (default: only unassigned)"
      echo -e "  ${DIM}--hide-done${RESET}    Hide subtasks with Done/Closed status"
      echo -e "  ${DIM}--mine${RESET}         Add filter by currentUser (combine with ${DIM}-a${RESET} or ${DIM}--hide-done${RESET})"
      echo -e "  ${DIM}--unassigned${RESET}   Show only unassigned tickets (combine with ${DIM}-a${RESET} or ${DIM}--hide-done${RESET})"
      exit 0 ;;
    -*)
      die "Unknown flag: $1" ;;
    *)
      [[ "$1" =~ ^[A-Z]+-[0-9]+$ ]] || die "'$1' doesn't look like a valid Jira key (e.g. CW-123)."
      TICKET_KEYS+=("$1")
      PROVIDED_TICKET_KEYS+=("$1")
      shift ;;
  esac
done

[[ ${#TICKET_KEYS[@]} -eq 0 && -z "$FIX_VERSION" ]] && \
  mapfile -t TICKET_KEYS < <(parent-tickets)

[[ ${#TICKET_KEYS[@]} -eq 0 && -z "$FIX_VERSION" ]] && \
  FIX_VERSION="$(fix-version)"

[[ ${#TICKET_KEYS[@]} -eq 0 && -z "$FIX_VERSION" ]] && \
  die "Usage: subtasks <TICKET-KEY> [<TICKET-KEY> ...] [-a] [--hide-done] [--fix-version <id>]"

[[ "$SHOW_ALL" == "true" ]]    && JQL_FLAGS+=("--all")
[[ "$HIDE_DONE" == "true" ]]   && JQL_FLAGS+=("--hide-done")
[[ "$MY_TASK" == "true" ]]     && JQL_FLAGS+=("--mine")
[[ "$NO_ASSIGNEE" == "true" ]] && JQL_FLAGS+=("--no-assignee")
[[ "$IN_PROGRESS" == "true" ]] && JQL_FLAGS+=("--status" "In Progress")
[[ -n "$FIX_VERSION" ]] && JQL_FLAGS+=("--fix-version" $FIX_VERSION)

# ── Label ─────────────────────────────────────────────────────────────────────
if   [[ "$HIDE_DONE" == "true" ]]; then LABEL="non-done"
elif [[ "$SHOW_ALL"  == "true" ]]; then LABEL="all"
else                                    LABEL="unassigned"
fi

# ── Fetch all keys in parallel ────────────────────────────────────────────────

if [[ ${#TICKET_KEYS[@]} -gt 0 ]]; then
  info "Fetching ${LABEL} subtasks for: $(IFS=','; echo "${TICKET_KEYS[*]}")..."
else
  info "Fetching ${LABEL} tickets for fixVersion=${FIX_VERSION}..."
fi

TMP_DIR=$(mktemp -d /tmp/subtasks-XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT

pids=()

if [[ ${#TICKET_KEYS[@]} -eq 0 ]]; then
  jql=$(build-jql "${JQL_FLAGS[@]}" --for-dev)
  # info "$jql"  # Debug query
  (
    acli jira workitem search \
      --jql "$jql" \
      --fields "summary,status,assignee,issuetype,priority" \
      --json --limit 200 2>&1 \
    > "$TMP_DIR/fix-version.json" \
    || echo "[]" > "$TMP_DIR/fix-version.json"
  ) &

  pids+=($!)

  TICKET_KEYS=("fix-version")

else
  for key in "${TICKET_KEYS[@]}"; do
    jql=$(build-jql "$key" "${JQL_FLAGS[@]}")

    (
      acli jira workitem search \
        --jql "$jql" \
        --fields "summary,status,assignee,issuetype,priority" \
        --json --limit 200 2>&1 \
      > "$TMP_DIR/${key}.json" \
      || echo "[]" > "$TMP_DIR/${key}.json"
    ) &

    pids+=($!)
  done
fi

# wait for all background fetches
for pid in "${pids[@]}"; do
  wait "$pid"
done

# ── Render ────────────────────────────────────────────────────────────────────
python3 - "$TMP_DIR" "$SHOW_ALL" "$LABEL" "$CUR_USER_EMAIL" "$FIX_VERSION" "${TICKET_KEYS[@]}" << 'EOF'
import sys, json, os

tmp_dir     = sys.argv[1]
show_all    = sys.argv[2] == "true"
label       = sys.argv[3]
cur_user_email = sys.argv[4]
fix_version = sys.argv[5]
ticket_keys = sys.argv[6:]

BASE_URL = "https://khalibre.atlassian.net/browse"

RESET = "\033[0m"
BOLD  = "\033[1m"
DIM   = "\033[2m"
GREEN   = "\033[0;32m"
LINE  = "\033[2m" + ("─" * 91) + "\033[0m"

STATUS_COLORS = {
    "In Progress":  "\033[44m",
    "Defining AC":  "\033[44m",
    "Done":         "\033[42m",
    "Closed":       "\033[42m",
    "Resolved":     "\033[42m",
    "Merged":       "\033[42m",
    "To Do":        "\033[47m",
    "Ready":        "\033[47m",
    "Open":         "\033[47m",
    "Ready for Dev":          "\033[47m",
    "PR Open":      "\033[44m",
    "Blocked":      "\033[41m",
    "Deployed to UAT":      "\033[42m",
    "Pending QA":           "\033[42m",
    "Failed QA":           "\033[41m",
    "Reopened":     "\033[48;5;240m"
}
DEFAULT_BG    = "\033[47m"
DEFAULT_COLOR = "\033[0;36m"

ISSUE_TYPE_COLORS = {
  "Task":         "\033[0;34m",
  "Sub-task":     "\033[0;34m",
  "Bug":          "\033[0;31m",
  "Defect":       "\033[0;31m",
  "Improvement":  "\033[0;33m",
  "Story":        "\033[0;32m",
  "Epic":         "\033[0;35m",
}

DEFAULT_PRIORITY_COLOR = "\033[48;5;250m"
PRIORITY_COLORS = {
    "Not set": "\033[48;5;250m",  # gray
    "Could":   "\033[48;5;208m",  # orange
    "Should":  "\033[43m",        # yellow
    "Must":    "\033[42m",        # green
    "Won't":   "\033[41m",        # red
}


def status_badge(name):
    col = STATUS_COLORS.get(name, DEFAULT_BG)
    return f"{col} {name} {RESET}"

def issue_type_color(name):
    col = ISSUE_TYPE_COLORS.get(name, DEFAULT_COLOR)
    return f"{col}{name}{RESET}"

def get_priority_badge(name):
  first = name[0].upper()
  col = PRIORITY_COLORS.get(name, DEFAULT_PRIORITY_COLOR)
  return f"{col} {first} {RESET}"

def assignee_text(email, name):
    if email == cur_user_email and name:
      return f"{GREEN}{name}{RESET}"
    else:
      return f"{name}" if name else f"{DIM}unassigned{RESET}"

print()
total_shown = 0

for i, pk in enumerate(ticket_keys):
    path = os.path.join(tmp_dir, f"{pk}.json")
    try:
        with open(path) as f:
            data = json.load(f)
        items = data if isinstance(data, list) else [data]
        items = [x for x in items if x.get("key")]
    except Exception:
        items = []

    count = len(items)
    total_shown += count

    print(
        f"  {BOLD}{('Fix Version: ' + fix_version) if pk == 'fix-version' else pk}{RESET} — {count} {label} subtask(s)"
    )
    print(f"  {LINE}")

    if not items:
        msg = f"{DIM}No subtasks found.{RESET}" if show_all else f"{DIM}✔ All assigned.{RESET}"
        print(f"    {msg}")
    else:
        for item in items:
            key       = item.get("key", "?")
            fields    = item.get("fields", {})
            summary   = fields.get("summary", "(no summary)")
            status    = fields.get("status", {}).get("name", "Unknown")
            asgn      = fields.get("assignee")
            asgn_name = asgn.get("displayName") if asgn else None
            email     = asgn.get("emailAddress") if asgn else None
            is_author = cur_user_email == email

            issuetype = fields.get("issuetype", {})
            type_name = issuetype.get("name") if isinstance(issuetype, dict) else None
            type_str  = f"{issue_type_color(type_name)}  " if type_name else ""

            priority              = fields.get("priority", {})
            priority_name         = priority.get("name") if isinstance(priority, dict) else None
            priority_text         = f"{get_priority_badge(priority_name)}" if priority_name else ""

            is_pickable           = not asgn_name or status == 'Failed QA'
            pick_action           = f"[r: pick-ticket {key}] · " if is_pickable else ""
            in_progress_action    = f"[r: in-progress {key}] · " if is_author and (status == 'Deployed to UAT' or status == 'Pending QA' or status == 'Merged' or status == 'Ready for Dev') else ""
            pr_open_action        = f"[r: pr-open {key}] · " if is_author and status == 'In Progress' else ""
            pr_merged_action        = f"[r: merged {key}] · " if is_author and status == 'PR Open' else ""
            deployed_to_uat_action        = f"[r: deployed-uat {key}] · " if status == 'Merged' else ""
            pending_qa_action     = f"[r: pending-qa {key}] · " if status == 'Deployed to UAT' else ""

            task_actions          = f"{pick_action}{in_progress_action}{pr_open_action}{pr_merged_action}{deployed_to_uat_action}{pending_qa_action}[r: view-ticket {key}]"

            print(f"    {BOLD}{key}{RESET}: {summary}")
            print(f"      {status_badge(status)} {priority_text} {type_str}{assignee_text(email, asgn_name)}  {task_actions}")
            print()


    if i < len(ticket_keys) - 1:
        print()

if len(ticket_keys) > 1:
    print(f"  {LINE}")
    print(f"  {DIM}Total: {total_shown} {label} subtask(s) across {len(ticket_keys)} tickets{RESET}")
    print()

EOF

echo ""
echo "── Frequent Actions ────────────────────────────────────────────────────────────────────────────────────────────────────"
ACTIONS="[r: subtasks --in-progress] · [r: subtasks --hide-done] · [r: subtasks --hide-done --mine] · [r: subtasks] · [r: prlist]"

if [[ ${#PROVIDED_TICKET_KEYS[@]} -gt 0 ]]; then
  (IFS=' '; echo "[r: subtasks ${PROVIDED_TICKET_KEYS[*]}]")
  (IFS=' '; echo "[r: subtasks ${PROVIDED_TICKET_KEYS[*]} --hide-done]")
  (IFS=' '; echo "[r: subtasks ${PROVIDED_TICKET_KEYS[*]} --in-progress]")
  (IFS=' '; echo "[r: subtasks ${PROVIDED_TICKET_KEYS[*]} --hide-done --mine]")
  echo "[r: prlist]"
elif [[ -n "$PROVIDED_FIX_VERSION" ]]; then
    (IFS=' '; echo "${ACTIONS} · [r: subtasks --fix-version ${PROVIDED_FIX_VERSION}]")
else
  echo "${ACTIONS}"
fi
echo ""
