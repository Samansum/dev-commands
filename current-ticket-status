#!/usr/bin/env bash
# current-ticket-status: Print Jira ticket current status
# Usage:
#   current-ticket-status CW-123

set -euo pipefail

# ── Helpers ──────────────────────────────────────────────────────────────────
R='\033[0;31m'      # Red
O='\033[38;5;208m'  # Orange
Y='\033[0;33m'      # Yellow
G='\033[0;32m'      # Green
B='\033[0;34m'      # Blue
W='\033[1;37m'      # Bright White
D='\033[0;90m'      # Dark Gray
C='\033[0;36m'      # Cyan
M='\033[0;35m'      # Magenta
NC='\033[0m'        # Reset / No Color

die()  { echo -e "${R}✖${NC}  $*" >&2; exit 1; }
error()  { echo -e "${R}✖${NC}  $*"; }
info() { echo -e "${C}▶${NC}  $*"; }
ok()   { echo -e "${G}✔${NC}  $*"; }
warn() { echo -e "${O}▲${NC}  $*"; }

[[ $# -lt 1 ]] && die "Usage: current-ticket-status <TICKET-KEY>"

TICKET_KEY="${1^^}"

[[ ! "$TICKET_KEY" =~ ^[A-Z]+-[0-9]+$ ]] \
  && die "Invalid ticket key '$TICKET_KEY'. Expected format: CW-123"

TICKET_JSON=$(acli jira workitem view \
  "$TICKET_KEY" \
  --fields status \
  --json 2>/dev/null) \
  || die "Failed to fetch Jira ticket '$TICKET_KEY'. Is acli authenticated?"

CURRENT_STATUS=$(echo "$TICKET_JSON" | python3 -c "
import sys, json

data = json.load(sys.stdin)
item = data[0] if isinstance(data, list) else data

print(item['fields']['status']['name'])
" 2>/dev/null) || die "Failed to parse ticket status."

echo "$CURRENT_STATUS"
