#!/usr/bin/env bash
# rebase: Checkout a branch and rebase it onto another branch
# Usage:
#   rebase <branch-to-rebase> <rebase-onto>
#   rebase --base <base-branch>   → rebase current branch onto base branch
#                                   uses origin if current branch is Jira ticket key
#                                   uses upstream if not

set -euo pipefail

# ── Helpers ──────────────────────────────────────────────────────────────────
R='\033[0;31m'      # Red
O='\033[38;5;208m' # Orange
Y='\033[0;33m'      # Yellow
G='\033[0;32m'      # Green
B='\033[0;34m'      # Blue
W='\033[1;37m'      # Bright White
D='\033[0;90m'      # Dark Gray
C='\033[0;36m'      # Cyan
M='\033[0;35m'      # Magenta
NC='\033[0m'        # Reset / No Color

die()  { echo -e "${R}✖${NC} $*" >&2; exit 1; }
error()  { echo -e "${R}✖${NC} $*"; }
info() { echo -e "${C}▶${NC} $*"; }
ok()   { echo -e "${G}✔${NC} $*"; }
warn() { echo -e "${O}▲${NC} $*"; }

# ── Ensure we're in a git repo ────────────────────────────────────────────────
git rev-parse --abbrev-ref HEAD &>/dev/null \
  || die "Not inside a git repository."

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# ── Parse args ────────────────────────────────────────────────────────────────

if [[ $# -eq 0 ]]; then
  # rebase
  TARGET_BRANCH="$CURRENT_BRANCH"
  ONTO_BRANCH="$(base-branch)"

elif [[ $# -eq 1 ]]; then
  # rebase CW-123
  TARGET_BRANCH="$1"
  ONTO_BRANCH="$(base-branch)"

elif [[ $# -eq 2 ]]; then
  # rebase CW-123 CW-234
  TARGET_BRANCH="$1"
  ONTO_BRANCH="$2"

else
  die "Usage:
  rebase
    Rebase current branch onto configured base branch

  rebase <branch>
    Checkout branch and rebase onto configured base branch

  rebase <branch-to-rebase> <rebase-onto>
    Checkout branch and rebase onto specified branch"
fi

# Checkout target branch if needed
if [[ "$CURRENT_BRANCH" != "$TARGET_BRANCH" ]]; then
  info "Checking out $TARGET_BRANCH..."
  git checkout "$TARGET_BRANCH"
else
  info "Already on $TARGET_BRANCH."
fi

# Existing remote selection logic
if [[ "$ONTO_BRANCH" =~ ^[A-Z]+-[0-9]+$ ]]; then
  REMOTE="origin"
else
  REMOTE="upstream"
fi

info "Fetching $REMOTE/$ONTO_BRANCH..."
git fetch "$REMOTE" "$ONTO_BRANCH" --quiet

info "Rebasing $TARGET_BRANCH onto $REMOTE/$ONTO_BRANCH..."
git pull --rebase "$REMOTE" "$ONTO_BRANCH"

ok "Done. $TARGET_BRANCH rebased onto $REMOTE/$ONTO_BRANCH."